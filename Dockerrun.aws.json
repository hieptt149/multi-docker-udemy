{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "client",
      "image": "hieptt149/multil-docker-client:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 80
        }
      ],
      "environment": [
        {
          "name": "REACT_APP_API_URL",
          "value": "http://your-api-url"
        }
      ]
    },
    {
      "name": "server",
      "image": "your-docker-image-for-server:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000
        }
      ],
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "your-database-url"
        },
        {
          "name": "REDIS_URL",
          "value": "your-redis-url"
        }
      ]
    }
  ]
}
